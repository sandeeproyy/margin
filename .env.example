# Margin — A private, multi-user print room for your EPSON / Windows printer
# Copy this file to .env, then customize as needed.

# -----------------------------------------------------------------------------
# Network & Server
# -----------------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0

# -----------------------------------------------------------------------------
# Deployment, Tunnel & Vercel Integration
# -----------------------------------------------------------------------------
# The public frontend origin (e.g. hosted on Vercel)
MARGIN_PUBLIC_ORIGIN=https://margin.vercel.app

# The tunnel URL pointing back to this laptop (Cloudflare, Tailscale, ngrok, etc.)
# Used for direct file uploads to bypass edge body limits
MARGIN_PUBLIC_API_URL=https://quiet-paper-1234.trycloudflare.com

# Shared secret header (x-margin-proxy) passed from Vercel rewrite to the laptop
MARGIN_PROXY_SECRET=your-random-32-byte-secret-here

# -----------------------------------------------------------------------------
# Admin (Owner) Account
# -----------------------------------------------------------------------------
MARGIN_ADMIN_EMAIL=owner@margin.local
MARGIN_ADMIN_NAME=Owner

# If omitted, a secure 16-character password is generated and saved once to
# data/admin-initial-password.txt.
MARGIN_ADMIN_PASSWORD=

# Set to true to allow anyone to register without an invitation code
MARGIN_OPEN_SIGNUP=false

# -----------------------------------------------------------------------------
# Print Authorization PIN Gate
# -----------------------------------------------------------------------------
# Shared PIN that all users enter before sending a job to the physical printer.
# Prevents accidental or unknown prints. Shared by the owner.
MARGIN_PRINT_PIN=292929
MARGIN_PIN_UNLOCK_MINUTES=30
MARGIN_PIN_ATTEMPTS=10

# -----------------------------------------------------------------------------
# Storage & Data Limits
# -----------------------------------------------------------------------------
# MARGIN_DATA_DIR=./data
MAX_UPLOAD_MB=25
MARGIN_MAX_PAGES=300
MARGIN_FILE_TTL_HOURS=2
MARGIN_HISTORY_LIMIT=24
MARGIN_SESSION_DAYS=30

# -----------------------------------------------------------------------------
# Quotas & Abuse Protection
# -----------------------------------------------------------------------------
MARGIN_DAILY_PAGES=120
MARGIN_GLOBAL_DAILY_PAGES=400
MARGIN_MAX_ACTIVE_JOBS=3
MARGIN_MAX_JOBS=6
MARGIN_UPLOADS_PER_HOUR=30
MARGIN_PRINTS_PER_HOUR=40
