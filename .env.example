# Margin - a private, invitation-only print room for a Windows laptop.
# Copy this file to ".env" and fill in the values for this laptop.
# Never commit .env.

# -----------------------------------------------------------------------------
# Local server
# -----------------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0

# -----------------------------------------------------------------------------
# Public interface (Vercel) + private tunnel
# -----------------------------------------------------------------------------
# The HTTPS address of the Vercel deployment. It must match exactly; requests
# arriving through Vercel are checked against this origin.
MARGIN_PUBLIC_ORIGIN=https://your-margin.vercel.app

# The tunnel address that points at this laptop. The browser uses it only for
# the one direct file-body upload, which keeps large documents away from
# Vercel's request-size limit. No trailing slash.
MARGIN_PUBLIC_API_URL=https://quiet-paper-1234.trycloudflare.com

# A long random value. Set the SAME value in the Vercel project environment as
# MARGIN_PROXY_SECRET. Vercel adds it as x-margin-proxy on every API request;
# the laptop rejects API requests that do not carry it.
MARGIN_PROXY_SECRET=replace-with-a-long-random-secret

# Vercel project environment variables (not read by the laptop):
#   MARGIN_TUNNEL_URL    = https://quiet-paper-1234.trycloudflare.com
#   MARGIN_PROXY_SECRET  = the same long random secret as above

# -----------------------------------------------------------------------------
# Owner account
# -----------------------------------------------------------------------------
MARGIN_ADMIN_EMAIL=owner@margin.local
MARGIN_ADMIN_NAME=Owner

# Leave blank to generate a strong password once in
# data/admin-initial-password.txt. Sign in, change it, then delete that file.
MARGIN_ADMIN_PASSWORD=

# Invitation-only is the default. Set true only if you really want anyone who
# finds the public address to be able to create an account.
MARGIN_OPEN_SIGNUP=false

# -----------------------------------------------------------------------------
# Payments (Razorpay)
# -----------------------------------------------------------------------------
# Every printed page costs MARGIN_PRICE_PER_PAGE_PAISE (100 paise, ₹1, by
# default). The price applies to every account, including the owner. Razorpay's
# minimum INR charge is ₹1, so a one-page job costs exactly ₹1.
#
# Add your Razorpay Key ID and Key Secret here. Use rzp_test_... keys while
# testing. Keys stay on this laptop; the browser only ever receives the public
# Key ID after a paid order is requested. Restart the backend after changing
# these values. Leave them blank to keep paid printing disabled.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
MARGIN_PRICE_PER_PAGE_PAISE=100
MARGIN_MINIMUM_CHARGE_PAISE=100
MARGIN_PAYMENT_ORDER_TTL_MINUTES=30

# -----------------------------------------------------------------------------
# Storage, limits and quotas
# -----------------------------------------------------------------------------
# Optional. Keep the default to store files beside the app.
# MARGIN_DATA_DIR=./data
MAX_UPLOAD_MB=25
MARGIN_MAX_PAGES=300
MARGIN_FILE_TTL_HOURS=2
MARGIN_HISTORY_LIMIT=24
MARGIN_SESSION_DAYS=30

MARGIN_DAILY_PAGES=120
MARGIN_GLOBAL_DAILY_PAGES=400
MARGIN_MAX_ACTIVE_JOBS=3
MARGIN_MAX_JOBS=6
MARGIN_UPLOADS_PER_HOUR=30
MARGIN_PRINTS_PER_HOUR=40
