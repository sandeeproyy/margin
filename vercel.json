{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "^/api/(.*)$",
      "headers": {
        "x-margin-proxy": "${MARGIN_PROXY_SECRET}"
      },
      "dest": "${MARGIN_TUNNEL_URL}/api/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
